// Locked Credential Store Copied via esentutl
// sigma: rules/windows/credential_access/proc_creation_esentutl_copy_credential_store.yml | profile: microsoft_xdr
DeviceProcessEvents
| where (FolderPath endswith "\\esentutl.exe" or ProcessVersionInfoOriginalFileName =~ "esentutl.exe") and (ProcessCommandLine contains " -y " or ProcessCommandLine contains " /y " or ProcessCommandLine contains " –y " or ProcessCommandLine contains " —y " or ProcessCommandLine contains " ―y ") and (ProcessCommandLine contains "/config/sam" or ProcessCommandLine contains "\\config\\sam" or ProcessCommandLine contains "/config/system" or ProcessCommandLine contains "\\config\\system" or ProcessCommandLine contains "/config/security" or ProcessCommandLine contains "\\config\\security" or ProcessCommandLine contains "ntds.dit")
