// Event Log Cleared or Redirected via wevtutil
// sigma: rules/windows/defense_impairment/proc_creation_wevtutil_log_tampering.yml | profile: microsoft_xdr
DeviceProcessEvents
| where (FolderPath endswith "\\wevtutil.exe" or ProcessVersionInfoOriginalFileName =~ "wevtutil.exe") and ((ProcessCommandLine contains " cl " or ProcessCommandLine contains " clear-log ") or ((ProcessCommandLine contains " sl " or ProcessCommandLine contains " set-log ") and (ProcessCommandLine contains " -lfn:" or ProcessCommandLine contains " /lfn:" or ProcessCommandLine contains " –lfn:" or ProcessCommandLine contains " —lfn:" or ProcessCommandLine contains " ―lfn:" or ProcessCommandLine contains " -logfilename:" or ProcessCommandLine contains " /logfilename:" or ProcessCommandLine contains " –logfilename:" or ProcessCommandLine contains " —logfilename:" or ProcessCommandLine contains " ―logfilename:" or ProcessCommandLine contains " -e:false" or ProcessCommandLine contains " /e:false" or ProcessCommandLine contains " –e:false" or ProcessCommandLine contains " —e:false" or ProcessCommandLine contains " ―e:false" or ProcessCommandLine contains " -enabled:false" or ProcessCommandLine contains " /enabled:false" or ProcessCommandLine contains " –enabled:false" or ProcessCommandLine contains " —enabled:false" or ProcessCommandLine contains " ―enabled:false")))
