// Hidden PowerShell With Encoded Command (C2 Stager Pattern)
// sigma: rules/windows/execution/proc_creation_powershell_hidden_encoded_launcher.yml | profile: microsoft_xdr
DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and (ProcessCommandLine contains " -w hidden" or ProcessCommandLine contains " /w hidden" or ProcessCommandLine contains " –w hidden" or ProcessCommandLine contains " —w hidden" or ProcessCommandLine contains " ―w hidden" or ProcessCommandLine contains " -w h " or ProcessCommandLine contains " /w h " or ProcessCommandLine contains " –w h " or ProcessCommandLine contains " —w h " or ProcessCommandLine contains " ―w h " or ProcessCommandLine contains " -w 1 " or ProcessCommandLine contains " /w 1 " or ProcessCommandLine contains " –w 1 " or ProcessCommandLine contains " —w 1 " or ProcessCommandLine contains " ―w 1 " or ProcessCommandLine contains " -wi hidden" or ProcessCommandLine contains " /wi hidden" or ProcessCommandLine contains " –wi hidden" or ProcessCommandLine contains " —wi hidden" or ProcessCommandLine contains " ―wi hidden" or ProcessCommandLine contains " -win hidden" or ProcessCommandLine contains " /win hidden" or ProcessCommandLine contains " –win hidden" or ProcessCommandLine contains " —win hidden" or ProcessCommandLine contains " ―win hidden" or ProcessCommandLine contains " -window hidden" or ProcessCommandLine contains " /window hidden" or ProcessCommandLine contains " –window hidden" or ProcessCommandLine contains " —window hidden" or ProcessCommandLine contains " ―window hidden" or ProcessCommandLine contains " -windowstyle hidden" or ProcessCommandLine contains " /windowstyle hidden" or ProcessCommandLine contains " –windowstyle hidden" or ProcessCommandLine contains " —windowstyle hidden" or ProcessCommandLine contains " ―windowstyle hidden" or ProcessCommandLine contains " -windowstyle 1 " or ProcessCommandLine contains " /windowstyle 1 " or ProcessCommandLine contains " –windowstyle 1 " or ProcessCommandLine contains " —windowstyle 1 " or ProcessCommandLine contains " ―windowstyle 1 ") and (ProcessCommandLine contains " -e " or ProcessCommandLine contains " /e " or ProcessCommandLine contains " –e " or ProcessCommandLine contains " —e " or ProcessCommandLine contains " ―e " or ProcessCommandLine contains " -ec " or ProcessCommandLine contains " /ec " or ProcessCommandLine contains " –ec " or ProcessCommandLine contains " —ec " or ProcessCommandLine contains " ―ec " or ProcessCommandLine contains " -en " or ProcessCommandLine contains " /en " or ProcessCommandLine contains " –en " or ProcessCommandLine contains " —en " or ProcessCommandLine contains " ―en " or ProcessCommandLine contains " -enc " or ProcessCommandLine contains " /enc " or ProcessCommandLine contains " –enc " or ProcessCommandLine contains " —enc " or ProcessCommandLine contains " ―enc " or ProcessCommandLine contains " -enco" or ProcessCommandLine contains " /enco" or ProcessCommandLine contains " –enco" or ProcessCommandLine contains " —enco" or ProcessCommandLine contains " ―enco")
