// Credential Registry Hive Saved via reg.exe
// sigma: rules/windows/credential_access/proc_creation_reg_save_credential_hives.yml | profile: microsoft_xdr
DeviceProcessEvents
| where (FolderPath endswith "\\reg.exe" or ProcessVersionInfoOriginalFileName =~ "reg.exe") and (ProcessCommandLine contains " save " or ProcessCommandLine contains " export ") and (ProcessCommandLine contains "hklm\\sam " or ProcessCommandLine contains "hklm\\sam\"" or ProcessCommandLine contains "hkey_local_machine\\sam " or ProcessCommandLine contains "hkey_local_machine\\sam\"" or ProcessCommandLine contains "hklm\\security " or ProcessCommandLine contains "hklm\\security\"" or ProcessCommandLine contains "hkey_local_machine\\security " or ProcessCommandLine contains "hkey_local_machine\\security\"" or ProcessCommandLine contains "hklm\\system " or ProcessCommandLine contains "hklm\\system\"" or ProcessCommandLine contains "hkey_local_machine\\system " or ProcessCommandLine contains "hkey_local_machine\\system\"")
